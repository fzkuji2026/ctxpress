{
  "schema": "ctxpress.experiment.protocol",
  "version": 1,
  "artifact_root": "..",
  "status": "paused_context_profile_configured",
  "family_count": 8,
  "protocol": "ctxpress_comparison",
  "start_mode": "task_start",
  "scope": "benchmark",
  "analysis": {
    "research_question": "Published online context-compression mechanisms transferred to one real host and model; compare quality, behavior and complete cost with explicit adaptation limits",
    "allocation": {
      "frozen_before_formal_runs": false,
      "interpretation": "Freeze tasks and explicit unbounded agent execution in a new plan before execution. Do not pool previous cohorts."
    },
    "source_catalog": "ctxpress.methods.paper_catalog",
    "context_design": {
      "version": "paper-context-128k-20261013-v1",
      "context": {
        "version": 1,
        "max_context_tokens": 128000,
        "compression_trigger_tokens": 102400
      },
      "counting": "complete rendered agent input; shared chars/4 and media estimate, not exact provider tokens",
      "scope": "Shared agent and auxiliary-model input limit; source history is not silently truncated to fit. Per-call generation limits are unchanged.",
      "native_fallback": false,
      "external_request_or_time_caps": false,
      "methods": [
        {
          "method": "ComplexityTrap",
          "args": {
            "n": 10,
            "pin_spec": false,
            "polling": 1,
            "context_profile": {
              "version": 1,
              "max_context_tokens": 128000,
              "compression_trigger_tokens": 102400
            }
          },
          "note": "Rolling masking retains 10 latest outputs; no global length trigger in this algorithm."
        },
        {
          "method": "ComplexityTrapSummary",
          "args": {
            "n": 21,
            "m": 10,
            "context_profile": {
              "version": 1,
              "max_context_tokens": 128000,
              "compression_trigger_tokens": 102400
            }
          },
          "note": "Author 21+10-turn checkpoint schedule retained; 102400 is not a substitute for turn counts."
        },
        {
          "method": "ComplexityTrapHybrid",
          "args": {
            "n": 43,
            "m": 10,
            "w": 10,
            "polling": 1,
            "context_profile": {
              "version": 1,
              "max_context_tokens": 128000,
              "compression_trigger_tokens": 102400
            }
          },
          "note": "Author 43+10-turn summary and latest-10 masking retained."
        },
        {
          "method": "AgentDiet",
          "args": {
            "a": 2,
            "b": 1,
            "threshold": 500,
            "min_saving": 400,
            "max_ratio": 0.8,
            "reflect_model": "gpt-6-luna",
            "bypass_filter": false,
            "context_profile": {
              "version": 1,
              "max_context_tokens": 128000,
              "compression_trigger_tokens": 102400
            }
          },
          "note": "500 is a per-step eligibility threshold, 400 minimum saving, 0.8 acceptance ratio; these are not context caps."
        },
        {
          "method": "ACONSource",
          "args": {
            "t_hist": 102400,
            "trigger_tokens": 102400,
            "t_obs": 25600,
            "keep_turns": 2,
            "summary_model": null,
            "context_profile": {
              "version": 1,
              "max_context_tokens": 128000,
              "compression_trigger_tokens": 102400
            }
          },
          "note": "History uses the complete-input 102400 trigger. Per-observation threshold is 25600 (window headroom); retain 2 recent turns."
        },
        {
          "method": "ReSumSource",
          "args": {
            "context_k": 125,
            "trigger_tokens": 102400,
            "interval": null,
            "summary_model": null,
            "context_profile": {
              "version": 1,
              "max_context_tokens": 128000,
              "compression_trigger_tokens": 102400
            }
          },
          "note": "Explicit 102400 complete-input trigger replaces the implicit 32k-derived trigger; periodic 40-turn trigger disabled."
        },
        {
          "method": "AgentFoldSource",
          "args": {
            "context_profile": {
              "version": 1,
              "max_context_tokens": 128000,
              "compression_trigger_tokens": 102400
            }
          },
          "note": "Agent chooses fold ranges and summary using its tool/visible tags; shared threshold is guidance, not a forced model call."
        },
        {
          "method": "SWEPruner",
          "args": {
            "threshold": 0.5,
            "min_chars": 500,
            "chunk_overlap_tokens": 50,
            "context_profile": {
              "version": 1,
              "max_context_tokens": 128000,
              "compression_trigger_tokens": 102400
            }
          },
          "note": "0.5 relevance score, 500 characters and 50-token overlap retained; focus question and real service remain required."
        },
        {
          "method": "TokenPilotLifecycle",
          "args": {
            "entry_budget": 25600,
            "batch_turns": 8,
            "min_chars": 256,
            "estimator_model": null,
            "context_profile": {
              "version": 1,
              "max_context_tokens": 128000,
              "compression_trigger_tokens": 102400
            }
          },
          "note": "Per-output cap increased from 2000 to 25600; lifecycle estimation every 8 requests retained, 256 is characters."
        },
        {
          "method": "ACM",
          "args": {
            "summary_model": null,
            "context_profile": {
              "version": 1,
              "max_context_tokens": 128000,
              "compression_trigger_tokens": 102400
            }
          },
          "note": "Agent-selected segments and archival retrieval; same window guidance, no forced replacement algorithm."
        },
        {
          "method": "CWL",
          "args": {
            "budget": 102400,
            "full_context": true,
            "context_profile": {
              "version": 1,
              "max_context_tokens": 128000,
              "compression_trigger_tokens": 102400
            }
          },
          "note": "102400 complete-input estimate including fixed instructions replaces 80000 conversation-only estimate; dependencies can still restore history."
        },
        {
          "method": "DTOC",
          "args": {
            "strategy": true,
            "context_profile": {
              "version": 1,
              "max_context_tokens": 128000,
              "compression_trigger_tokens": 102400
            }
          },
          "note": "Agent controls hide/show; shared window guidance; strategy instructions enabled."
        },
        {
          "method": "ContextFoldingTools",
          "args": {
            "max_branches": null,
            "branch_max_turns": null,
            "branch_timeout": null,
            "branch_tokens": 25600,
            "context_profile": {
              "version": 1,
              "max_context_tokens": 128000,
              "compression_trigger_tokens": 102400
            }
          },
          "note": "Remove lifetime branch count and branch time/turn caps; 25600 branch-growth allowance uses shared headroom, complete-pair protection retained."
        },
        {
          "method": "FoldActSource",
          "args": {
            "max_model_len": 128000,
            "selection_tokens": 102400,
            "max_obs_length": null,
            "context_profile": {
              "version": 1,
              "max_context_tokens": 128000,
              "compression_trigger_tokens": 102400
            }
          },
          "note": "128000 model-length setting, explicit 102400 selection budget; remove 4096 observation clipping and its forced last-three-turn side effect."
        },
        {
          "method": "TACO",
          "args": {
            "uncovered_threshold": 3000,
            "freeze_rules": false,
            "task_category": "software-engineering",
            "summary_model": null,
            "context_profile": {
              "version": 1,
              "max_context_tokens": 128000,
              "compression_trigger_tokens": 102400
            }
          },
          "note": "3000 uncovered characters triggers rule induction, not a token cap; rule feedback and dynamic planning retained."
        },
        {
          "method": "CoMem",
          "args": {
            "trigger_tokens": 102400,
            "interval": 1,
            "lag": 1,
            "summary_model": null,
            "context_profile": {
              "version": 1,
              "max_context_tokens": 128000,
              "compression_trigger_tokens": 102400
            }
          },
          "note": "Only schedule a new async summary at 102400; retain one-step lag, settle pending calls and preserve full source archive."
        },
        {
          "method": "LongSeeker",
          "args": {
            "context_profile": {
              "version": 1,
              "max_context_tokens": 128000,
              "compression_trigger_tokens": 102400
            }
          },
          "note": "Agent chooses among five operations; shared window guidance, no forced summary mechanism."
        },
        {
          "method": "ZipRL",
          "args": {
            "context_profile": {
              "version": 1,
              "max_context_tokens": 128000,
              "compression_trigger_tokens": 102400
            }
          },
          "note": "Agent chooses compression level 1–5 and summary; shared window guidance, no artificial length replacement."
        }
      ],
      "validation": "local synthetic contract tests; no real execution after reconfiguration",
      "interpretation": "128k means 128000 tokens. Experimental input limit, not model physical capacity; 131072 remainder is excluded."
    }
  },
